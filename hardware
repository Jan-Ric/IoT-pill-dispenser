void sendStatusToFirebase(String medicineId, String scheduleId, String status, bool taken) {
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  if (!timeInitialized) {
    if (syncTimeWithNTP()) {
      timeInitialized = true;
    }
  } else {
    updateTime();
  }

  String currentDateTime = getFormattedDateTime();
  String currentTime = getFormattedTime();
  String currentDate = getFormattedDate();

  const char *host = "meditrack-24ee5-default-rtdb.asia-southeast1.firebasedatabase.app";
  const int port = 443;

  client.setTimeout(5000);

  unsigned long connectStart = millis();
  bool connected = false;

  while (millis() - connectStart < 8000) {
    if (client.connect(host, port)) {
      connected = true;
      break;
    }
    delay(300);
  }

  if (!connected) {
    client.stop();
    return;
  }

  String json = "{";
  json += "\"medicineId\":\"" + medicineId + "\",";
  json += "\"scheduleId\":\"" + scheduleId + "\",";
  json += "\"medicine_taken\":" + String(taken ? "true" : "false") + ",";
  json += "\"status\":\"" + status + "\",";
  json += "\"date\":\"" + currentDate + "\",";
  json += "\"time\":\"" + currentTime + "\",";
  json += "\"datetime\":\"" + currentDateTime + "\",";
  json += "\"timestamp\":{\".sv\":\"timestamp\"}";
  json += "}";

  String request = "PUT /medicine_updates.json HTTP/1.1\r\n";
  request += "Host: " + String(host) + "\r\n";
  request += "Content-Type: application/json\r\n";
  request += "Content-Length: " + String(json.length()) + "\r\n";
  request += "Connection: close\r\n\r\n";
  request += json;

  client.print(request);

  unsigned long responseStart = millis();

  while (millis() - responseStart < 3000) {
    if (client.available()) {
      String statusLine = client.readStringUntil('\n');
      if (statusLine.indexOf("200") > 0) {
        break;
      }
      break;
    }
    delay(10);
  }

  client.stop();
}
