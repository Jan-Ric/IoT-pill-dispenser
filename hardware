String getCurrentTimeString() {
  if (!timeInitialized) return "00:00";

  int h = timeClient.getHours();
  int m = timeClient.getMinutes();

  char timeStr[6];
  sprintf(timeStr, "%02d:%02d", h, m);
  return String(timeStr);
}

void updateTime() {
  if (!timeInitialized) return;

  timeClient.update();

  unsigned long epochTime = timeClient.getEpochTime();
  if (epochTime < 1704067200) {
    timeInitialized = false;
  }
}

String getFormattedDateTime() {
  if (!timeInitialized) return "Time not synced";

  unsigned long epochTime = timeClient.getEpochTime();
  int days = epochTime / 86400;
  int year = 1970;

  while (days >= 365) {
    bool isLeap = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    int daysInYear = isLeap ? 366 : 365;

    if (days >= daysInYear) {
      days -= daysInYear;
      year++;
    } else {
      break;
    }
  }

  int month = 1;
  int day = 1;
  int daysInMonth[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };

  if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) {
    daysInMonth[1] = 29;
  }

  for (int i = 0; i < 12; i++) {
    if (days >= daysInMonth[i]) {
      days -= daysInMonth[i];
      month++;
    } else {
      day = days + 1;
      break;
    }
  }

  char dateTimeStr[20];
  sprintf(dateTimeStr, "%04d-%02d-%02d %02d:%02d:%02d",
          year, month, day,
          timeClient.getHours(),
          timeClient.getMinutes(),
          timeClient.getSeconds());

  return String(dateTimeStr);
}

