void checkDispenseCommand() {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiSSLClient dispenseClient;
  const char *host = "meditrack-24ee5-default-rtdb.asia-southeast1.firebasedatabase.app";
  const int port = 443;

  if (!dispenseClient.connect(host, port)) {
    dispenseClient.stop();
    return;
  }

  String request = "GET /dispense_command.json HTTP/1.1\r\n";
  request += "Host: " + String(host) + "\r\n";
  request += "Connection: close\r\n\r\n";

  dispenseClient.print(request);

  unsigned long timeout = millis();
  while (dispenseClient.available() == 0) {
    if (millis() - timeout > 3000) {
      dispenseClient.stop();
      return;
    }
  }

  while (dispenseClient.available()) {
    String line = dispenseClient.readStringUntil('\n');
    if (line == "\r") break;
  }

  String response = "";
  while (dispenseClient.available()) {
    response += (char)dispenseClient.read();
  }
  dispenseClient.stop();

  if (response.indexOf("\"servoIndex\":") > 0) {
    int servoStart = response.indexOf("\"servoIndex\":\"") + 14;
    int servoEnd = response.indexOf("\"", servoStart);
    String servoIndexStr = response.substring(servoStart, servoEnd);
    int servoIndex = servoIndexStr.toInt();

    String scheduleId = "";
    int schedIdStart = response.indexOf("\"scheduleId\":\"");
    if (schedIdStart > 0) {
      schedIdStart += 14;
      int schedIdEnd = response.indexOf("\"", schedIdStart);
      scheduleId = response.substring(schedIdStart, schedIdEnd);
    }

    int medIdx = -1;
    for (int i = 0; i < medicineCount; i++) {
      if (medicines[i].servoIndex == servoIndex) {
        medIdx = i;
        break;
      }
    }

    if (medIdx >= 0) {
      int schedIdx = -1;
      for (int j = 0; j < medicines[medIdx].scheduleCount; j++) {
        if (medicines[medIdx].schedules[j].id == scheduleId) {
          schedIdx = j;
          break;
        }
      }

      if (schedIdx >= 0) {
        clearDispenseCommand();

        // Check if already dispensed to prevent duplicates from manual commands
        if (!medicines[medIdx].schedules[schedIdx].dispensed) {
          medicines[medIdx].schedules[schedIdx].dispensed = true;
          enqueueDispense(medIdx, schedIdx, "manual");
          delay(2000); 
          clearDispenseCommand();
        } else {
          lcdPrint("Already Queued", medicines[medIdx].name.substring(0, 13), 1500);
        }
      } else {
        clearDispenseCommand();
      }
    } else {
      clearDispenseCommand();
    }
  }
}
