bool syncTimeWithNTP() {
  timeSyncAttempts++;

  timeClient.setPoolServerName(ntpServers[currentNTPServer]);

  for (int i = 0; i < 5; i++) {
    if (timeClient.forceUpdate()) {
      unsigned long epochTime = timeClient.getEpochTime();

      if (epochTime > 1704067200 && epochTime < 4102444800) {
        timeSyncAttempts = 0;
        currentNTPServer = 0;
        return true;
      }
    }
    delay(1000);
  }

  currentNTPServer = (currentNTPServer + 1) % NUM_NTP_SERVERS;

  return false;
}

float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  float distance = duration * 0.034 / 2.0;

  if (distance == 0 || distance > 400) return -1;

  return distance;
}

void setServoAngle(uint8_t channel, int angle) {
  angle = constrain(angle, 0, 180);
  int pulse = map(angle, 0, 180, SERVOMIN, SERVOMAX);
  pwm.setPWM(channel, 0, pulse);
}

void operateServoSequence(int servoA, int servoB, String medicineName) {
  lcdPrint("Dispensing", "Servo A: 90°");
  setServoAngle(servoA, SERVO_OPEN);
  delay(SERVO_DELAY);

  lcdPrint("Dispensing", "Servo A: Close");
  setServoAngle(servoA, SERVO_CLOSED);
  delay(3000);

  lcdPrint("Dispensing", "Servo B: 90°");
  setServoAngle(servoB, SERVO_OPEN);
  delay(SERVO_DELAY);

  lcdPrint("Dispensing", "Servo B: Close");
  setServoAngle(servoB, SERVO_CLOSED);
}

void dispenseMedicine(int medicineIndex, int scheduleIndex) {
  if (medicineIndex < 0 || medicineIndex >= medicineCount) return;

  Medicine &med = medicines[medicineIndex];

  if (scheduleIndex < 0 || scheduleIndex >= med.scheduleCount) return;

  Schedule &sched = med.schedules[scheduleIndex];

  // Double-check if already dispensed (prevent double dispensing)
  if (sched.dispensed && sched.taken) {
    lcdPrint("Already Done", med.name.substring(0, 13), 1500);
    return;
  }

  lcdPrint("DISPENSING", med.name.substring(0, 13), 1500);

  int servoA = med.servoIndex * 2;
  int servoB = med.servoIndex * 2 + 1;

  operateServoSequence(servoA, servoB, med.name);

  sched.dispensed = true;
  sched.taken = false;
  sched.alert = false;
  med.dispenseTime = millis();
  med.monitorStartTime = millis();
  med.currentScheduleId = sched.id;

  updateTime();
  lcdPrint("Sending Data", "To Firebase...", 1000);
  sendStatusToFirebase(med.id, sched.id, "dispensed", false);

  currentMonitoringMedicine = medicineIndex;

  lcdPrint("Dispense Done", "Monitoring...", 2000);
}

void monitorMedicineTaken(int medicineIndex) {
  if (medicineIndex < 0 || medicineIndex >= medicineCount) return;

  Medicine &med = medicines[medicineIndex];

  int schedIdx = -1;
  for (int i = 0; i < med.scheduleCount; i++) {
    if (med.schedules[i].id == med.currentScheduleId) {
      schedIdx = i;
      break;
    }
  }

  if (schedIdx < 0) {
    currentMonitoringMedicine = -1;
    return;
  }

  Schedule &sched = med.schedules[schedIdx];

  if (sched.taken || sched.alert) {
    currentMonitoringMedicine = -1;
    return;
  }

  unsigned long currentMillis = millis();
  unsigned long elapsedTime = currentMillis - med.monitorStartTime;
  unsigned long remainingTime = (TIMEOUT_DURATION - elapsedTime) / 1000;

  if (currentMillis - lastDistanceCheck >= 500) {
    lastDistanceCheck = currentMillis;

    float distance = getDistance();

    if (distance > 0) {
      String line1 = med.name.substring(0, 13);
      String line2 = String(distance, 1) + "cm  " + String(remainingTime) + "s";

      // Show queue count if there are pending items
      if (!isQueueEmpty()) {
        line2 = String(distance, 1) + "cm Q:" + String(queueCount);
      }

      lcdPrint(line1, line2);

      if (distance > DISTANCE_TAKEN) {
        lcdPrint("MEDICINE TAKEN!", med.name.substring(0, 13), 3000);

        sched.taken = true;
        currentMonitoringMedicine = -1;

        updateTime();
        lcdPrint("Updating App", "Please wait...", 1000);
        sendStatusToFirebase(med.id, sched.id, "taken", true);

        lcdPrint("Update Complete", "Check App!", 2000);

        // Show queue status after monitoring is done
        if (!isQueueEmpty()) {
          lcdPrint("Queue Processing", String(queueCount) + " remaining", 1500);
        } else {
          lcdPrint("MediTrack", timeInitialized ? getCurrentTimeString() : "Syncing...");
        }

        return;
      }
    }
  }

  if (elapsedTime >= TIMEOUT_DURATION) {
    lcdPrint("  ALERT!", "Not Taken!", 2000);

    activateBuzzer();

    updateTime();
    lcdPrint("Sending Alert", "To App...", 1000);
    sendStatusToFirebase(med.id, sched.id, "alert", false);

    sched.alert = true;
    currentMonitoringMedicine = -1;

    lcdPrint("Alert Sent!", "Check App", 2000);

    // Show queue status after monitoring is done
    if (!isQueueEmpty()) {
      lcdPrint("Queue Processing", String(queueCount) + " remaining", 1500);
    } else {
      lcdPrint("MediTrack", timeInitialized ? getCurrentTimeString() : "Syncing...");
    }
  }
}

void activateBuzzer() {
  for (int i = 0; i < 3; i++) {
    lcdPrint("  ALERT!", "Beep " + String(i + 1) + "/3");
    digitalWrite(BUZZER_PIN, LOW);
    delay(1000);
    digitalWrite(BUZZER_PIN, HIGH);
    delay(500);
  }
}

// ============= MODIFIED: Add all matching schedules to queue =============
void checkSchedules() {
  if (!timeInitialized || medicineCount == 0) return;

  String currentTime = getCurrentTimeString();
  int schedulesFound = 0;

  for (int i = 0; i < medicineCount; i++) {
    Medicine &med = medicines[i];

    for (int j = 0; j < med.scheduleCount; j++) {
      Schedule &sched = med.schedules[j];

      if (currentTime == sched.time && !sched.dispensed) {
        schedulesFound++;

        if (schedulesFound == 1) {
          lcdPrint("SCHEDULE TIME!", String(schedulesFound) + " Medicine(s)", 1500);
        }

        // Mark as dispensed BEFORE adding to queue to prevent duplicates
        sched.dispensed = true;

        // Add to queue
        enqueueDispense(i, j, "scheduled");
      }
    }
  }

  if (schedulesFound > 1) {
    lcdPrint("Multiple Meds", String(schedulesFound) + " queued!", 2000);
  }
}
