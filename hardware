void setup() {
  lcd.init();
  lcd.backlight();
  lcdPrint("  MediTrack", "  Booting...", 1000);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  lcdPrint("Init Sensors", "Ultrasonic: OK", 1000);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, HIGH);
  lcdPrint("Init Sensors", "Buzzer: OK", 1000);

  pwm.begin();
  pwm.setPWMFreq(SERVO_FREQ);
  delay(10);

  lcdPrint("Init Servos", "Testing...", 500);

  for (int i = 0; i < 6; i++) {
    setServoAngle(i, SERVO_CLOSED);
    delay(100);
  }

  lcdPrint("Init Complete", "All Servos OK", 1000);

  lcdPrint("WiFi Connect", "Please wait...");

  WiFi.begin(ssid, password);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    attempts++;
  }

  if (WiFi.status() != WL_CONNECTED) {
    lcdPrint("WiFi FAILED!", "Check Router", 3000);
    while (1) { delay(1000); }
  }

  lcdPrint("WiFi Connected!", WiFi.localIP().toString().substring(0, 13), 2000);

  lcdPrint("Sync Time", "NTP Server...");

  timeClient.begin();

  bool timeSynced = syncTimeWithNTP();

  if (timeSynced) {
    timeInitialized = true;
    lastNTPUpdate = millis();
    lcdPrint("Time Synced!", getCurrentTimeString(), 2000);
  } else {
    lcdPrint("Time Sync", "Failed-Retry", 2000);
  }

  lcdPrint("Loading", "Medicines...", 1000);
  loadMedicinesFromFirebase();

  lcdPrint("  SYSTEM READY", "  All OK!", 2000);
  lcdPrint("MediTrack", timeInitialized ? getCurrentTimeString() : "Syncing...");
}

void loop() {
  unsigned long currentMillis = millis();

  if (!timeInitialized) {
    if (currentMillis - lastNTPUpdate >= 2000) {
      if (syncTimeWithNTP()) {
        timeInitialized = true;
        lcdPrint("Time Synced!", getCurrentTimeString(), 2000);
      }
      lastNTPUpdate = currentMillis;
    }
  } else {
    if (currentMillis - lastNTPUpdate >= 10000) {
      updateTime();
      lastNTPUpdate = currentMillis;
    }
  }

  if (currentMillis - lastSyncCheck >= 5000) {
    checkSyncCommand();
    lastSyncCheck = currentMillis;
  }

  if (currentMillis - lastDispenseCheck >= 5000) {
    checkDispenseCommand();
    lastDispenseCheck = currentMillis;
    
  }
  if (currentMillis - lastRestartCheck >= 5000) {
    checkRestartCommand();
    lastRestartCheck = currentMillis;
  }
  if (currentMillis - lastScheduleCheck >= 30000) {
    checkSchedules();
    lastScheduleCheck = currentMillis;
  }

  // ============= MODIFIED: Process queue when monitoring is done =============
  if (currentMonitoringMedicine >= 0) {
    monitorMedicineTaken(currentMonitoringMedicine);
  } else {
    // Process queue when not monitoring
    if (!isQueueEmpty()) {
      processDispenseQueue();
    } else {
      if (currentMillis - lastLCDUpdate >= 5000) {
        lcdPrint("MediTrack", timeInitialized ? getCurrentTimeString() : "Syncing...");
        lastLCDUpdate = currentMillis;
      }
    }
  }
  // ===========================================================================

  delay(50);
}

void loadMedicinesFromFirebase() {
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  WiFiSSLClient loadClient;
  const char *host = "meditrack-24ee5-default-rtdb.asia-southeast1.firebasedatabase.app";
  const int port = 443;

  if (!loadClient.connect(host, port)) {
    lcdPrint("Load Failed", "Try Again", 2000);
    loadClient.stop();
    return;
  }

  String request = "GET /medicines.json HTTP/1.1\r\n";
  request += "Host: " + String(host) + "\r\n";
  request += "Connection: close\r\n\r\n";

  loadClient.print(request);

  unsigned long timeout = millis();
  while (loadClient.available() == 0) {
    if (millis() - timeout > 5000) {
      loadClient.stop();
      return;
    }
  }

  while (loadClient.available()) {
    String line = loadClient.readStringUntil('\n');
    if (line == "\r") break;
  }

  String response = "";
  while (loadClient.available()) {
    response += (char)loadClient.read();
  }
  loadClient.stop();

  medicineCount = 0;

  for (int slotIdx = 0; slotIdx < 3; slotIdx++) {
    String slotKey = "\"slot_" + String(slotIdx) + "\"";
    int slotPos = response.indexOf(slotKey);

    if (slotPos < 0) continue;

    int nullCheck = response.indexOf("null", slotPos);
    int nextBrace = response.indexOf("{", slotPos);

    if (nullCheck > 0 && nullCheck < nextBrace) {
      continue;
    }

    Medicine &med = medicines[medicineCount];

    int nameStart = response.indexOf("\"name\":\"", slotPos) + 8;
    int nameEnd = response.indexOf("\"", nameStart);
    med.name = response.substring(nameStart, nameEnd);

    int dosageStart = response.indexOf("\"dosage\":\"", slotPos) + 10;
    int dosageEnd = response.indexOf("\"", dosageStart);
    med.dosage = response.substring(dosageStart, dosageEnd);

    int servoStart = response.indexOf("\"servoIndex\":", slotPos) + 13;
    int servoEnd = response.indexOf(",", servoStart);
    if (servoEnd < 0) servoEnd = response.indexOf("}", servoStart);
    med.servoIndex = response.substring(servoStart, servoEnd).toInt();

    med.id = "slot_" + String(slotIdx);
    med.scheduleCount = 0;
    med.dispenseTime = 0;
    med.monitorStartTime = 0;
    med.currentScheduleId = "";

    int schedulesStart = response.indexOf("\"schedules\":[", slotPos);
    if (schedulesStart > 0) {
      int schedulesEnd = response.indexOf("]", schedulesStart);
      String schedulesBlock = response.substring(schedulesStart + 13, schedulesEnd);

      int pos = 0;
      while (pos < schedulesBlock.length() && med.scheduleCount < 10) {
        int schedStart = schedulesBlock.indexOf("{", pos);
        if (schedStart < 0) break;

        int schedEnd = schedulesBlock.indexOf("}", schedStart);
        String schedBlock = schedulesBlock.substring(schedStart, schedEnd + 1);

        Schedule &sched = med.schedules[med.scheduleCount];

        int idStart = schedBlock.indexOf("\"id\":\"") + 6;
        int idEnd = schedBlock.indexOf("\"", idStart);
        sched.id = schedBlock.substring(idStart, idEnd);

        int timeStart = schedBlock.indexOf("\"time\":\"") + 8;
        int timeEnd = schedBlock.indexOf("\"", timeStart);
        sched.time = schedBlock.substring(timeStart, timeEnd);

        sched.dispensed = false;
        sched.taken = false;
        sched.alert = false;

        med.scheduleCount++;
        pos = schedEnd + 1;
      }
    }

    medicineCount++;
  }

  lcdPrint("Loaded OK!", String(medicineCount) + " Medicines", 2000);
}

