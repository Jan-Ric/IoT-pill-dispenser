// ============= NEW: QUEUE IMPLEMENTATION =============
bool enqueueDispense(int medIndex, int schedIndex, String source) {
  if (isQueueFull()) {
    lcdPrint("Queue Full!", "Cannot Add", 2000);
    return false;
  }

  dispenseQueue[queueRear].medicineIndex = medIndex;
  dispenseQueue[queueRear].scheduleIndex = schedIndex;
  dispenseQueue[queueRear].source = source;

  queueRear = (queueRear + 1) % MAX_QUEUE_SIZE;
  queueCount++;

  lcdPrint("Added to Queue", "Position: " + String(queueCount), 1500);
  return true;
}

bool dequeueDispense(DispenseTask &task) {
  if (isQueueEmpty()) {
    return false;
  }

  task = dispenseQueue[queueFront];
  queueFront = (queueFront + 1) % MAX_QUEUE_SIZE;
  queueCount--;

  return true;
}

bool isQueueEmpty() {
  return queueCount == 0;
}

bool isQueueFull() {
  return queueCount >= MAX_QUEUE_SIZE;
}

void processDispenseQueue() {
  if (isProcessingQueue || isQueueEmpty()) {
    return;
  }

  // Don't process queue if currently monitoring
  if (currentMonitoringMedicine >= 0) {
    return;
  }

  isProcessingQueue = true;

  DispenseTask task;
  if (dequeueDispense(task)) {
    lcdPrint("Processing Queue", String(queueCount) + " remaining", 1500);

    String sourceMsg = task.source == "manual" ? "MANUAL" : "SCHEDULED";
    lcdPrint(sourceMsg + " Disp", medicines[task.medicineIndex].name.substring(0, 13), 1500);

    dispenseMedicine(task.medicineIndex, task.scheduleIndex);
  }

  isProcessingQueue = false;
}
